# Copy to .env — read by docker-compose.yml
WFO_ADMIN_USER=admin
WFO_ADMIN_PASSWORD=change-me-on-first-start
WFO_JWT_SECRET=                     # empty → generated once per store and kept under the store root
WFO_JOB_WORKERS=2                   # concurrent engine runs in the API process
WFO_CORES=8                         # CPU cap (joblib / compose limits)
WFO_SSO_TRUST=0                     # 1 only behind a corporate SSO proxy that sets X-SSO-User
WFO_UI_PORT=8080                    # prod: nginx port
WFO_PORT=8000                       # offline: single-container port
WFO_SOURCES=./data                  # host folder with CSV / XLSX / Parquet sources (read-only in the container)
WFO_BACKUPS=./backups               # host folder receiving nightly archives (prod) / manual backups (offline)
WFO_BACKUP_RETAIN=14
WFO_BACKUP_INTERVAL_S=86400
WFO_TAG=0.5.0
